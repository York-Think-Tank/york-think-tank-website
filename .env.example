# Database
DATABASE_NAME=strapi
DATABASE_USERNAME=admin
DATABASE_PASSWORD=admin
HOST_DATABASE_PORT=5432  # dev only

# Strapi
DATABASE_CLIENT=postgres
DATABASE_HOST=strapiDB

# Strapi secrets
# generate each with: openssl rand -base64 32
APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=toBeModified
ADMIN_JWT_SECRET=toBeModified
TRANSFER_TOKEN_SALT=toBeModified
JWT_SECRET=toBeModified
ENCRYPTION_KEY=toBeModified

# Frontend section
STRAPI_READ_API_KEY=your_read_api_key
# Must be reachable from a browser (media/PDF links are rendered with it).
# Dev: http://localhost:1337 — Prod: https://<CMS_DOMAIN>
STRAPI_URL=http://localhost:1337

# Production only (docker-compose.prod.yaml / nginx)
# Uncomment on the server so plain `docker compose` runs the prod stack, not the dev one
# COMPOSE_FILE=docker-compose.prod.yaml
SITE_DOMAIN=example.com
CMS_DOMAIN=cms.example.com

# Backups, see ops/backup/README.md. Left empty the site still runs, it just isn't backed up.
# BACKUP_REPOSITORY is s3:<endpoint>/<bucket>, BACKUP_PASSWORD from: openssl rand -base64 48
BACKUP_REPOSITORY=
BACKUP_PASSWORD=
BACKUP_B2_KEY_ID=
BACKUP_B2_APPLICATION_KEY=
# Optional, healthchecks.io URLs so you get an email when a backup fails
BACKUP_HEALTHCHECK_URL=
BACKUP_CHECK_HEALTHCHECK_URL=
